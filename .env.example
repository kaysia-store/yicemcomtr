# Supabase proje adresi
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public anahtarı. Service role anahtarını buraya koymayın.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# QR kodun açacağı adres. Sonda / olmasın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kurulum:
# 1. Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# 2. Supabase SQL Editor'da supabase/migrations/0001_init.sql dosyasını çalıştırın.
# 3. Authentication bölümünden tek bir admin kullanıcısı oluşturun.
#    Bu projede authenticated olan her kullanıcı menüyü yönetebilir.
