# Supabase proje adresi. Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public anahtarı. Settings → API → anon public
# Service role anahtarını buraya koymayın.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# QR kodun açacağı adres. Sonda / olmasın.
# Yerel: http://localhost:3000
# Vercel: https://alan-adiniz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kurulum:
# 1. Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# 2. Supabase SQL Editor'da sırayla çalıştırın:
#    supabase/migrations/0001_init.sql
#    supabase/migrations/0002_category_features.sql
#    supabase/migrations/0003_languages.sql
#    supabase/migrations/0004_show_title.sql
# 3. Authentication → Users ile tek bir admin oluşturun (Auto Confirm açık).
# 4. Authentication → Providers → Email içinde "Allow new users to sign up" kapalı olsun.
#    Giriş yapan her kullanıcı menüyü yönetebilir.
# 5. Aynı üç değişkeni Vercel projesine de ekleyin. Kök dizin repo köküdür.
